    {
      "parameters": {
        "jsCode": "const events = $input.first().json.body?.events || $input.first().json.events || [];\nconst event = events[0] || {};\nconst msg = event.message || {};\n\nreturn {\n  json: {\n    messageType: msg.type || 'unknown',\n    messageText: msg.text || '',\n    replyToken: event.replyToken || ''\n  }\n};"
      },
