      "parameters": {
        "jsCode": "const items = $input.all().map(i => i.json);\nconst now = new Date().toLocaleString('zh-TW', { timeZone: 'Asia/Taipei' });\n\nconst rows = items.map(s => `\n  <tr>\n    <td>${s.sna || ''}</td>\n    <td style=\"color:#16a34a;font-weight:bold\">${s.sbi ?? ''}</td>\n    <td style=\"color:#dc2626;font-weight:bold\">${s.bemp ?? ''}</td>\n    <td>${s.tot ?? ''}</td>\n    <td>${s.ar || ''}</td>\n    <td>${s.mday || ''}</td>\n  </tr>`).join('');\n\nconst html = `<!DOCTYPE html>\n<html lang=\"zh-Hant\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>大安區 YouBike 即時資訊</title>\n<style>\n  body { font-family: -apple-system, \"Microsoft JhengHei\", sans-serif; background:#f8fafc; margin:0; padding:24px; }\n  h1 { color:#1e293b; }\n  .meta { color:#64748b; margin-bottom:16px; }\n  table { width:100%; border-collapse:collapse; background:#fff; box-shadow:0 1px 3px rgba(0,0,0,.1); border-radius:8px; overflow:hidden; }\n  th, td { padding:10px 14px; text-align:left; border-bottom:1px solid #e2e8f0; font-size:14px; }\n  th { background:#0f172a; color:#fff; }\n  tr:hover { background:#f1f5f9; }\n</style>\n</head>\n<body>\n  <h1>🚲 大安區 YouBike 即時資訊</h1>\n  <div class=\"meta\">共 ${items.length} 站，頁面產生時間：${now}</div>\n  <table>\n    <thead>\n      <tr><th>站名</th><th>可借車</th><th>可還車</th><th>總度</th><th>地址</th><th>資料更新時間</th></tr>\n    </thead>\n    <tbody>${rows}</tbody>\n  </table>\n</body>\n</html>`;\n\nreturn [{ json: { html } }];"
      },
