      "parameters": {
        "jsCode": "const messageType = $input.first().json.messageType || 'unknown';\nreturn {\n  json: {\n    replyToken: $input.first().json.replyToken,\n    replyBody: {\n      replyToken: $input.first().json.replyToken,\n      messages: [\n        {\n          type: 'text',\n          text: '不支援' + messageType + '訊息'\n        }\n      ]\n    }\n  }\n};"
      },
